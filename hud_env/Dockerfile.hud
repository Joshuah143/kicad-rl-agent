# Dockerfile for the kicad-schematics HUD Environment (remote / cloud hosting).
#
# `hud deploy` tarballs THIS directory (hud_env/) as the build context and builds
# remotely. The main package therefore must live INSIDE this context: deploy.sh
# vendors ../src, ../tasks, ../pyproject.toml, ../README.md into ./_pkg/ first.
# Always deploy via `./deploy.sh` (or run the vendor step yourself), never a bare
# `hud deploy` — otherwise ./_pkg is missing and the build fails.
#
# KiCad (for ERC inside cloud rollouts) is OFF by default to keep the image small
# and the remote build fast/reliable. Turn it on with:
#     hud deploy . --build-arg INSTALL_KICAD=1
# When KiCad is absent the env auto-skips ERC (KICAD_RL_DISABLE_ERC is also set
# below); the reward still scores graph/electrical/cost/size/availability.

FROM python:3.12-slim

# uv for fast, reproducible installs.
RUN pip install --no-cache-dir uv

# Optional KiCad CLI (ERC in cloud rollouts). Off by default; --build-arg INSTALL_KICAD=1 to include.
ARG INSTALL_KICAD=0
RUN if [ "$INSTALL_KICAD" = "1" ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends kicad \
        && rm -rf /var/lib/apt/lists/* ; \
    fi

WORKDIR /app

# Vendored main package (kicad-rl-agent) — populated by deploy.sh into hud_env/_pkg.
COPY _pkg/pyproject.toml _pkg/README.md ./_pkg/
COPY _pkg/src ./_pkg/src
COPY _pkg/tasks ./_pkg/tasks

# The HUD environment itself.
COPY env.py tasks.py ./

# Install the main package + hud-python into the system interpreter (flat image).
RUN uv pip install --system --no-cache ./_pkg "hud-python[agents]>=0.6.5,<0.7"

# Tasks live in the vendored copy; ERC defaults off (no KiCad unless built in).
ENV KICAD_RL_TASKS_DIR=/app/_pkg/tasks
ENV KICAD_RL_DISABLE_ERC=1

# Serve the Environment's tcp JSON-RPC control channel.
EXPOSE 8765
CMD ["hud", "serve", "env:env", "--host", "0.0.0.0", "--port", "8765"]

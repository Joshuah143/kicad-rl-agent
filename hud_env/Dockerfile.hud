# Dockerfile for the kicad-schematics HUD Environment (remote hosting).
#
# IMPORTANT: local training/eval needs NO Docker at all — just `cd hud_env &&
# uv sync` and run `train.py` / `hud eval`. This image is only for hosting the
# environment remotely (e.g. `hud deploy`, or HUDRuntime/Modal-hosted rollouts).
#
# The build context MUST be the REPO ROOT (so the COPY lines below can reach the
# main package under ../src). Build it with:
#
#     docker build -f hud_env/Dockerfile.hud -t kicad-hud-env .
#
# (run from the repository root, NOT from inside hud_env/).

FROM python:3.12-slim

# uv for fast, reproducible installs.
RUN pip install --no-cache-dir uv

# KiCad CLI so ERC contributes to the reward inside the container. This is a
# large dependency; drop it (and set KICAD_RL_DISABLE_ERC=1 at runtime) if you
# want a leaner image and ERC-free rollouts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends kicad \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- main package (kicad-rl-agent) ---------------------------------------
# Paths are relative to the repo root build context.
COPY pyproject.toml README.md ./
COPY src ./src
COPY tasks ./tasks

# --- the HUD environment subproject --------------------------------------
COPY hud_env/env.py hud_env/tasks.py hud_env/pyproject.toml ./hud_env/

# Install the main package + hud-python into the system interpreter. We install
# directly (not via the hud_env path-dependency project) to keep the image flat.
RUN uv pip install --system --no-cache . "hud-python[agents]>=0.6.5,<0.7"

# Tasks live at /app/tasks; point the env there explicitly.
ENV KICAD_RL_TASKS_DIR=/app/tasks
WORKDIR /app/hud_env

# Serve the Environment's tcp JSON-RPC control channel.
EXPOSE 8765
CMD ["hud", "serve", "env:env", "--host", "0.0.0.0", "--port", "8765"]
